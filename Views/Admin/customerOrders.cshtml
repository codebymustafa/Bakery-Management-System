@model List<Bakery_Management_System.Models.Order>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="section">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="section-header mb-0">
                <i class="ion ion-clock text-warning mr-2"></i>Pending Orders
            </h1>
            <small class="text-muted">Review new orders placed by customers awaiting confirmation or rejection.</small>
        </div>
        <a asp-action="AllOrders" class="btn btn-outline-secondary rounded-pill">View All Pipeline Orders &rarr;</a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Order #</th>
                                <th>Date & Time</th>
                                <th>Customer Email</th>
                                <th>Items Ordered</th>
                                <th>Total Price</th>
                                <th>Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                var total = order.OrderItems.Sum(oi => oi.Price);
                                string status = order.OrderStatus ?? "Pending";
                                string badgeClass = status == "Pending" ? "badge-warning" : "badge-danger";

                                <tr>
                                    <td class="font-weight-bold text-danger">#@order.OrderId</td>
                                    <td>
                                        <small class="text-dark font-weight-bold d-block">
                                            @(order.OrderDate?.ToString("dd MMM yyyy, hh:mm tt") ?? "N/A")
                                        </small>
                                    </td>
                                    <td>
                                        <strong class="text-dark font-weight-bold">@(order.User?.Username ?? $"User #{order.UserId}")</strong>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill" type="button" data-toggle="collapse" data-target="#items_pend_@order.OrderId">
                                            <i class="fas fa-shopping-basket mr-1"></i> @order.OrderItems.Count Item(s)
                                        </button>
                                        <div class="collapse mt-2" id="items_pend_@order.OrderId">
                                            <div class="card card-body p-2 bg-light border-0 small">
                                                @foreach (var item in order.OrderItems)
                                                {
                                                    <div class="d-flex justify-content-between border-bottom py-1">
                                                        <span>@(item.Product?.ProductName ?? "Custom Cake Item") (x@item.Quantity)</span>
                                                        <strong class="text-dark">PKR @item.Price.ToString("N0")</strong>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="font-weight-bold text-success">PKR @total.ToString("N0")</td>
                                    <td><span class="badge @badgeClass px-3 py-1">@status</span></td>
                                    <td class="text-right">
                                        @if (status == "Pending")
                                        {
                                            <form asp-action="AcceptOrder" asp-route-id="@order.OrderId" method="post" class="d-inline mr-1">
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 font-weight-bold shadow-sm">
                                                    <i class="fas fa-check mr-1"></i> Accept Order
                                                </button>
                                            </form>
                                            <form asp-action="RejectOrder" asp-route-id="@order.OrderId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to reject Order #@order.OrderId? Stock will be restored.');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    <i class="fas fa-times mr-1"></i> Reject
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Processed</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="fas fa-clock fs-1 text-secondary mb-3 d-block"></i>
                    <h5>No pending customer orders awaiting review.</h5>
                </div>
            }
        </div>
    </div>
</section>
