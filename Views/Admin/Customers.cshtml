@model List<Bakery_Management_System.Models.User>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
}

<section class="section">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="section-header mb-0">
                <i class="ion ion-person-stalker text-danger mr-2"></i>Customer Management
            </h1>
            <small class="text-muted">Registered customer accounts and purchasing activity.</small>
        </div>
    </div>

    <!-- Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Customers" class="form-row align-items-center">
                <div class="col-md-9 mb-2 mb-md-0">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                        </div>
                        <input type="text" name="search" class="form-control border-left-0" placeholder="Search customer by email address..." value="@currentSearch" />
                    </div>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark btn-block font-weight-bold rounded-pill">Search Customers</button>
                    @if (!string.IsNullOrEmpty(currentSearch))
                    {
                        <a asp-action="Customers" class="btn btn-outline-secondary ml-2 rounded-pill"><i class="fas fa-undo"></i></a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Customers Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>User ID</th>
                                <th>Customer Email / Username</th>
                                <th>Account Role</th>
                                <th>Total Orders</th>
                                <th>Total Spent</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                int orderCount = user.Orders?.Count ?? 0;
                                decimal totalSpent = user.Orders != null
                                    ? user.Orders.SelectMany(o => o.OrderItems).Sum(oi => oi.Price)
                                    : 0;

                                <tr>
                                    <td class="font-weight-bold text-muted">#@user.UserId</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-user-circle text-danger fs-4 mr-2"></i>
                                            <strong class="text-dark font-weight-bold">@user.Username</strong>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-success px-3 py-1 font-weight-bold">@user.UserRole</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-light border px-3 py-1 font-weight-bold">
                                            @orderCount Order(s)
                                        </span>
                                    </td>
                                    <td class="font-weight-bold text-success">PKR @totalSpent.ToString("N0")</td>
                                    <td class="text-right">
                                        <a asp-action="AllOrders" asp-route-search="@user.Username" class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="fas fa-receipt mr-1"></i> View Orders
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="fas fa-user-slash fs-1 text-secondary mb-3 d-block"></i>
                    <h5>No customer accounts found.</h5>
                </div>
            }
        </div>
    </div>
</section>
