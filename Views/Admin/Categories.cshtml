@model List<Bakery_Management_System.Models.ProductCategory>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="section">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="section-header mb-0">
                <i class="ion ion-pricetags text-danger mr-2"></i>Product Categories
            </h1>
            <small class="text-muted">Manage all store product categories and sub-sections.</small>
        </div>
        <button type="button" class="btn btn-danger rounded-pill px-4 font-weight-bold shadow-sm" data-toggle="modal" data-target="#addCategoryModal">
            <i class="fas fa-plus mr-1"></i> Add Category
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Category ID</th>
                                <th>Category Name</th>
                                <th>Products Count</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cat in Model)
                            {
                                int productCount = cat.Products?.Count ?? 0;
                                <tr>
                                    <td class="font-weight-bold text-muted">#@cat.CategoryId</td>
                                    <td>
                                        <strong class="text-dark font-weight-bold fs-6">@cat.CategoryName</strong>
                                    </td>
                                    <td>
                                        <span class="badge badge-info px-3 py-1 font-weight-bold">
                                            @productCount Product(s)
                                        </span>
                                    </td>
                                    <td class="text-right">
                                        <button type="button" class="btn btn-sm btn-outline-warning rounded-pill mr-1" onclick="openEditModal(@cat.CategoryId, '@cat.CategoryName')">
                                            <i class="fas fa-edit"></i> Rename
                                        </button>
                                        <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete category \'@cat.CategoryName\'?');">
                                            <input type="hidden" name="id" value="@cat.CategoryId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill" @(productCount > 0 ? "disabled title=\"Cannot delete category containing products.\"" : "")>
                                                <i class="fas fa-trash-alt"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="fas fa-folder-open fs-1 text-secondary mb-3 d-block"></i>
                    <h5>No product categories found.</h5>
                    <p class="small">Click 'Add Category' above to create your first category.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-plus-circle mr-2"></i>Add New Category</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="AddCategory" method="post">
                <div class="modal-body p-4">
                    <div class="form-group mb-0">
                        <label class="font-weight-bold text-dark">Category Name <span class="text-danger">*</span></label>
                        <input type="text" name="CategoryName" class="form-control form-control-lg" placeholder="e.g. Macarons & Delights" required />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 justify-content-between">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 font-weight-bold">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Category Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-edit mr-2"></i>Rename Category</h5>
                <button type="button" class="close text-dark" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form asp-action="EditCategory" method="post">
                <input type="hidden" name="CategoryId" id="editCategoryId" value="" />
                <div class="modal-body p-4">
                    <div class="form-group mb-0">
                        <label class="font-weight-bold text-dark">Category Name <span class="text-danger">*</span></label>
                        <input type="text" name="CategoryName" id="editCategoryName" class="form-control form-control-lg" required />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 justify-content-between">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark rounded-pill px-4 font-weight-bold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditModal(id, name) {
        document.getElementById('editCategoryId').value = id;
        document.getElementById('editCategoryName').value = name;
        $('#editCategoryModal').modal('show');
    }
</script>
}
