@model List<Bakery_Management_System.Models.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as List<Bakery_Management_System.Models.ProductCategory> ?? new List<Bakery_Management_System.Models.ProductCategory>();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    int? currentCategory = ViewBag.CurrentCategory as int?;
}

<section class="section">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="section-header mb-0">
                <i class="ion ion-ios-list text-danger mr-2"></i>Product Catalog
            </h1>
            <small class="text-muted">Total @totalCount products found in store inventory.</small>
        </div>
        <a asp-action="AddProduct" class="btn btn-danger rounded-pill px-4 font-weight-bold shadow-sm">
            <i class="fas fa-plus mr-1"></i> Add New Product
        </a>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="ProductList" class="form-row align-items-center">
                <div class="col-md-5 mb-2 mb-md-0">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                        </div>
                        <input type="text" name="search" class="form-control border-left-0" placeholder="Search product by name or description..." value="@currentSearch" />
                    </div>
                </div>
                <div class="col-md-4 mb-2 mb-md-0">
                    <select name="categoryId" class="form-control">
                        <option value="">-- All Categories --</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.CategoryId" selected="@(currentCategory == cat.CategoryId)">@cat.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark btn-block font-weight-bold rounded-pill">Filter</button>
                    @if (!string.IsNullOrEmpty(currentSearch) || currentCategory.HasValue)
                    {
                        <a asp-action="ProductList" class="btn btn-outline-secondary ml-2 rounded-pill" title="Reset Filters"><i class="fas fa-undo"></i></a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Products Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Stock Quantity</th>
                                <th>Description</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                string qtyBadge = item.ProductQuantity <= 5 ? "badge-danger" : (item.ProductQuantity <= 15 ? "badge-warning" : "badge-success");
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@item.ProductImage" alt="@item.ProductName" class="rounded mr-3 shadow-sm" style="width: 55px; height: 55px; object-fit: cover;" />
                                            <div>
                                                <strong class="d-block text-dark">@item.ProductName</strong>
                                                <small class="text-muted">ID: #@item.ProductId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge badge-light border px-3 py-1 font-weight-bold text-secondary">
                                            @(item.Category?.CategoryName ?? "Uncategorized")
                                        </span>
                                    </td>
                                    <td class="font-weight-bold text-danger">PKR @item.ProductPrice.ToString("N0")</td>
                                    <td>
                                        <span class="badge @qtyBadge px-3 py-1">
                                            @item.ProductQuantity Units
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;" title="@item.ProductDescription">
                                            @(string.IsNullOrEmpty(item.ProductDescription) ? "No description provided." : item.ProductDescription)
                                        </small>
                                    </td>
                                    <td class="text-right">
                                        <a asp-action="EditProduct" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-warning rounded-pill mr-1">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" onclick="confirmDelete(@item.ProductId, '@item.ProductName')">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls -->
                @if (totalPages > 1)
                {
                    <div class="p-3 bg-light d-flex justify-content-between align-items-center flex-wrap">
                        <small class="text-muted">Showing Page @currentPage of @totalPages (@totalCount Total Products)</small>
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="ProductList" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-categoryId="@currentCategory">&laquo; Prev</a>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="ProductList" asp-route-page="@i" asp-route-search="@currentSearch" asp-route-categoryId="@currentCategory">@i</a>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="ProductList" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-categoryId="@currentCategory">Next &raquo;</a>
                            </li>
                        </ul>
                    </div>
                }
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="fas fa-box-open fs-1 text-secondary mb-3 d-block"></i>
                    <h5>No products found matching your search.</h5>
                    <p class="small">Try adjusting your keyword filter or adding new bakery products.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteProductModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-trash-alt mr-2"></i>Confirm Delete Product</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4 text-center">
                <p class="lead mb-2">Are you sure you want to delete <strong id="deleteProductName" class="text-danger">this product</strong>?</p>
                <small class="text-muted">This action will permanently remove the product and its image from the store catalog.</small>
            </div>
            <div class="modal-footer bg-light border-0 justify-content-between">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-dismiss="modal">Cancel</button>
                <form id="deleteProductForm" method="post" asp-action="DeleteProduct">
                    <input type="hidden" name="id" id="deleteProductId" value="" />
                    <button type="submit" class="btn btn-danger rounded-pill px-4 font-weight-bold">Delete Product</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function confirmDelete(id, name) {
        document.getElementById('deleteProductId').value = id;
        document.getElementById('deleteProductName').textContent = name;
        $('#deleteProductModal').modal('show');
    }
</script>
}
