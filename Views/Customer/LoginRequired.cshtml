@{
    ViewBag.Title = "Login Required - Royal Bakers";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="login-required-page">
    <div class="login-required-card">
        <div class="lock-badge">
            <i class="fas fa-lock"></i>
        </div>
        <h2>Login Required</h2>
        <p>
            You must be logged in to your <strong>Royal Bakers</strong> account to access this page.
            Please sign in or create a free account to continue.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a asp-controller="Customer" asp-action="login" class="btn-go-login">
                <i class="fas fa-sign-in-alt me-2"></i>Proceed to Login
            </a>
            <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                <i class="fas fa-home me-2"></i>Back to Home
            </a>
        </div>
    </div>
</div>

<style>
    .login-required-page {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 60px 20px;
        background: radial-gradient(circle at 50% 30%, #FFF0F3 0%, #FFE5D9 55%, #FFF8F0 100%);
    }

    .login-required-card {
        max-width: 500px;
        width: 100%;
        background: rgba(255,255,255,0.97);
        backdrop-filter: blur(20px);
        border-radius: 30px;
        padding: 50px 40px;
        text-align: center;
        box-shadow: 0 25px 60px rgba(92, 58, 33, 0.1);
        border: 1px solid rgba(244,172,183,0.5);
    }

    .lock-badge {
        width: 88px;
        height: 88px;
        background: linear-gradient(135deg, #FFD6E0, #F4ACB7);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
        color: #D81B60;
        box-shadow: 0 12px 30px rgba(244,172,183,0.45);
        margin-bottom: 28px;
    }

    .login-required-card h2 {
        font-family: 'Playfair Display', serif;
        font-size: 2.1rem;
        font-weight: 700;
        color: #3D231D;
        margin-bottom: 14px;
    }

    .login-required-card p {
        color: #7E5742;
        font-size: 1.05rem;
        line-height: 1.7;
        margin-bottom: 32px;
    }

    .btn-go-login {
        display: inline-flex;
        align-items: center;
        background: linear-gradient(135deg, #F4ACB7, #D81B60);
        color: #FFFFFF !important;
        font-size: 1rem;
        font-weight: 700;
        padding: 14px 34px;
        border-radius: 30px;
        border: none;
        box-shadow: 0 10px 28px rgba(216, 27, 96, 0.3);
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .btn-go-login:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 36px rgba(216, 27, 96, 0.4);
        color: #FFFFFF !important;
    }

    @@media (max-width: 576px) {
        .login-required-card {
            padding: 36px 24px;
        }
        .login-required-card h2 {
            font-size: 1.7rem;
        }
    }
</style>
