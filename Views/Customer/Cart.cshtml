@model List<Bakery_Management_System.Models.Cart>
@{
    ViewBag.Title = "Your Shopping Cart";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    decimal subtotal    = Model != null ? Model.Sum(c => c.Price) : 0;
    decimal deliveryFee = subtotal > 0 ? 150 : 0;
    decimal grandTotal  = subtotal + deliveryFee;
    int     itemCount   = Model?.Sum(c => c.Quantity) ?? 0;
}

<div class="page-hero-banner">
    <div class="container">
        <h1>Shopping Cart</h1>
        <p class="lead text-muted mb-0">@(Model != null && Model.Any() ? $"{itemCount} item{(itemCount == 1 ? "" : "s")} in your cart" : "Your cart is empty")</p>
    </div>
</div>

<div class="container py-5">

    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger rounded-4 mb-4 shadow-sm">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["CartError"]
        </div>
    }
    @if (TempData["OrderSuccess"] != null)
    {
        <div class="alert alert-success rounded-4 mb-4 shadow-sm">
            <i class="fas fa-check-circle me-2"></i>@TempData["OrderSuccess"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            <!-- Cart Items Table -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead style="background:#FFF0F3;">
                                <tr>
                                    <th class="ps-4 py-3 fw-bold text-muted small text-uppercase">Product</th>
                                    <th class="py-3 fw-bold text-muted small text-uppercase">Unit Price</th>
                                    <th class="py-3 fw-bold text-muted small text-uppercase">Qty</th>
                                    <th class="py-3 fw-bold text-muted small text-uppercase">Subtotal</th>
                                    <th class="pe-4 py-3"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var imgSrc = !string.IsNullOrEmpty(item.Product?.ProductImage)
                                        ? item.Product.ProductImage
                                        : "/img/cake_card.jpg";
                                    var unitPrice = item.Product?.ProductPrice ?? 0;

                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@Url.Content("~" + imgSrc)"
                                                     class="rounded-3 border"
                                                     width="65" height="65"
                                                     style="object-fit:cover;"
                                                     alt="@item.Product?.ProductName">
                                                <div>
                                                    <div class="fw-bold text-dark small">@(item.Product?.ProductName ?? "Bakery Item")</div>
                                                    <small class="text-muted">Freshly Baked</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-muted small">PKR @unitPrice.ToString("N0")</td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-3 py-2 fs-6 rounded-pill">@item.Quantity</span>
                                        </td>
                                        <td class="fw-bold text-danger">PKR @item.Price.ToString("N0")</td>
                                        <td class="pe-4">
                                            <form method="post" asp-controller="Customer" asp-action="RemoveFromCart" class="d-inline">
                                                <input type="hidden" name="cartId" value="@item.CartId" />
                                                <button type="submit" class="btn btn-sm btn-light border-0 text-danger rounded-circle"
                                                        title="Remove item" style="width:36px;height:36px;">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top:90px; background:#FFF8F0;">
                    <h5 class="fw-bold text-dark mb-4" style="font-family:'Playfair Display',serif;">
                        <i class="fas fa-receipt text-danger me-2"></i>Order Summary
                    </h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Items (@itemCount)</span>
                        <span class="fw-semibold small">PKR @subtotal.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted small">Express Delivery</span>
                        <span class="fw-semibold small">PKR @deliveryFee.ToString("N0")</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold text-dark">Grand Total</span>
                        <span class="fw-bold text-danger fs-5">PKR @grandTotal.ToString("N0")</span>
                    </div>

                    <!-- Checkout posts to the real Checkout action -->
                    <form method="post" asp-controller="Customer" asp-action="Checkout">
                        <button type="submit" class="btn btn-danger w-100 rounded-pill py-3 fw-bold shadow">
                            <i class="fas fa-check-circle me-2"></i>Proceed to Checkout
                        </button>
                    </form>

                    <a asp-controller="Customer" asp-action="Shop"
                       class="btn btn-outline-secondary w-100 rounded-pill py-2 mt-3 fw-semibold small">
                        <i class="fas fa-arrow-left me-2"></i>Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="card border-0 shadow-sm rounded-4 p-5 mx-auto" style="max-width:480px; background:#FFFFFF;">
                <i class="fas fa-shopping-bag opacity-25 text-danger mb-4" style="font-size:5rem;"></i>
                <h3 class="fw-bold text-dark mb-2" style="font-family:'Playfair Display',serif;">Your Cart is Empty</h3>
                <p class="text-muted mb-4">Browse our fresh artisan bakery treats and add your favourites!</p>
                <a asp-controller="Customer" asp-action="Shop"
                   class="btn btn-danger rounded-pill px-5 py-3 fw-bold shadow">
                    <i class="fas fa-store me-2"></i>Browse Our Shop
                </a>
            </div>
        </div>
    }
</div>
